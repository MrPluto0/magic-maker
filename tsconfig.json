{
  "include": ["src/**/*", "./auto-imports.d.ts", "./components.d.ts"],
  "exclude": ["src/**/*.vue"],
  "compilerOptions": {
    "target": "ES2020",
    "types": ["vite/client", "@types/wicg-file-system-access"],
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "strict": false,
    "paths": {
      "@/*": ["./src/*"],
      "@pkg/*": ["./packages/*"]
    }
  }
}
