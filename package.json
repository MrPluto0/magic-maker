{
  "name": "magic-maker",
  "version": "0.0.1",
  "license": "Apache 2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build",
    "format": "biome format --write src packages/excalidraw/types",
    "lint": "biome lint --write src packages/excalidraw/types",
    "ci": "biome ci src packages/excalidraw/types",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "simple-git-hooks",
    "deploy": "gh-pages -d dist -b gh-pages",
    "test": "vitest run",
    "gen:tools": "tsx scripts/gen-tool-schema.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,jsx,json,less,css}": "biome check --no-errors-on-unmatched"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.4.1",
    "@vueuse/core": "^11.2.0",
    "@webav/av-cliper": "^1.2.8",
    "axios": "^1.3.2",
    "element-plus": "^2.14.7",
    "hotkeys-js": "^3.13.7",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.0.9",
    "openai": "^5.19.1",
    "opfs-tools": "^0.4.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "recorder-core": "^1.3.24102001",
    "vue": "^3.5.44",
    "vue-clipboard3": "^2.0.0",
    "vue-hooks-plus": "1.6.0-alpha.2",
    "vue-router": "^4.6.4",
    "vue3-moveable": "^0.18.1",
    "wavesurfer.js": "^7.7.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@iconify-json/ep": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^26.6.5",
    "@types/wicg-file-system-access": "^2023.10.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "gh-pages": "^6.3.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "unocss": "^66.11.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
