{
	"$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["src/**", "!packages/excalidraw/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"useHookAtTopLevel": "off",
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn",
				"noUnusedFunctionParameters": "warn",
				"useParseIntRadix": "warn"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noArrayIndexKey": "warn",
				"noAssignInExpressions": "warn",
				"noConfusingVoidType": "warn",
				"noDoubleEquals": "warn",
				"noGlobalIsNan": "warn"
			},
			"complexity": {
				"noBannedTypes": "warn",
				"noStaticOnlyClass": "off",
				"useOptionalChain": "warn",
				"useLiteralKeys": "warn",
				"useIndexOf": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useTemplate": "warn"
			},
			"a11y": {
				"noSvgWithoutTitle": "warn",
				"noStaticElementInteractions": "warn",
				"useKeyWithClickEvents": "warn",
				"useButtonType": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
